        "selector": "JSXOpeningElement[name.name='Welcome'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|description|extra|variant|key|ref|className|style|children)$/]",
        "message": "<Welcome> doesn't accept that prop. Declared props: icon, title, description, extra, variant."
