        "selector": "JSXOpeningElement[name.name='Welcome'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:borderless|filled)$/]",
        "message": "<Welcome> variant must be one of 'borderless' | 'filled'."
      }
