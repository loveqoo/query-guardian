{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/**",
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "components/x/**",
              "ui_kits/admin/**",
              "ui_kits/agent-debug/**",
              "ui_kits/chat/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='A2UIMessage'] > JSXAttribute > JSXIdentifier[name!=/^(?:createSurface|updateComponents|updateDataModel|key|ref|className|style|children)$/]",
        "message": "<A2UIMessage> doesn't accept that prop. Declared props: createSurface, updateComponents, updateDataModel."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|message|description|showIcon|closable|onClose|action|className|style|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: type, message, description, showIcon, closable, onClose, action, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:success|info|warning|error)$/]",
        "message": "<Alert> type must be one of 'success' | 'info' | 'warning' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|size|shape|children|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, size, shape, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:circle|square)$/]",
        "message": "<Avatar> shape must be one of 'circle' | 'square'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|dot|showZero|overflowCount|status|text|color|children|className|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: count, dot, showZero, overflowCount, status, text, color, children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:success|processing|default|error|warning)$/]",
        "message": "<Badge> status must be one of 'success' | 'processing' | 'default' | 'error' | 'warning'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BreadcrumbItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|label|icon|onClick|key|ref|className|style|children)$/]",
        "message": "<BreadcrumbItem> doesn't accept that prop. Declared props: title, label, icon, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Bubble'] > JSXAttribute > JSXIdentifier[name!=/^(?:placement|avatar|header|content|variant|shape|loading|typing|footer|children|key|ref|className|style|children)$/]",
        "message": "<Bubble> doesn't accept that prop. Declared props: placement, avatar, header, content, variant, shape, loading, typing, footer, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Bubble'] > JSXAttribute[name.name='placement'] > Literal[value!=/^(?:start|end)$/]",
        "message": "<Bubble> placement must be one of 'start' | 'end'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Bubble'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:filled|outlined|shadow|borderless)$/]",
        "message": "<Bubble> variant must be one of 'filled' | 'outlined' | 'shadow' | 'borderless'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Bubble'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:default|round|corner)$/]",
        "message": "<Bubble> shape must be one of 'default' | 'round' | 'corner'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|size|danger|shape|block|disabled|loading|icon|iconName|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: type, size, danger, shape, block, disabled, loading, icon, iconName, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|extra|cover|actions|hoverable|size|bordered|bodyStyle|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: title, extra, cover, actions, hoverable, size, bordered, bodyStyle, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:default|small)$/]",
        "message": "<Card> size must be one of 'default' | 'small'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|defaultChecked|indeterminate|disabled|onChange|children|className|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, defaultChecked, indeterminate, disabled, onChange, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConversationItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|icon|onMenu|key|ref|className|style|children)$/]",
        "message": "<ConversationItem> doesn't accept that prop. Declared props: key, label, icon, onMenu."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|spin|rotate|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, spin, rotate."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|status|disabled|prefix|suffix|prefixIcon|suffixIcon|allowClear|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: size, status, disabled, prefix, suffix, prefixIcon, suffixIcon, allowClear."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:small|middle|large)$/]",
        "message": "<Input> size must be one of 'small' | 'middle' | 'large'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:error|warning)$/]",
        "message": "<Input> status must be one of 'error' | 'warning'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|icon|disabled|type|children|key|ref|className|style|children)$/]",
        "message": "<MenuItem> doesn't accept that prop. Declared props: key, label, icon, disabled, type, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuItem'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:item|group)$/]",
        "message": "<MenuItem> type must be one of 'item' | 'group'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|children|okText|cancelText|okType|okDanger|footer|width|onOk|onCancel|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: open, title, children, okText, cancelText, okType, okDanger, footer, width, onOk, onCancel."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute[name.name='okType'] > Literal[value!=/^(?:primary|default)$/]",
        "message": "<Modal> okType must be one of 'primary' | 'default'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PromptItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|icon|iconColor|label|description|disabled|style|key|ref|className|style|children)$/]",
        "message": "<PromptItem> doesn't accept that prop. Declared props: key, icon, iconColor, label, description, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Radio'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|disabled|onChange|children|className|key|ref|className|style|children)$/]",
        "message": "<Radio> doesn't accept that prop. Declared props: checked, disabled, onChange, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|disabled|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: label, value, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sender'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|defaultValue|placeholder|onChange|onSubmit|onCancel|loading|disabled|prefix|header|footer|actions|className|style|key|ref|className|style|children)$/]",
        "message": "<Sender> doesn't accept that prop. Declared props: value, defaultValue, placeholder, onChange, onSubmit, onCancel, loading, disabled, prefix, header, footer, actions, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|defaultChecked|disabled|size|checkedChildren|unCheckedChildren|onChange|className|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, defaultChecked, disabled, size, checkedChildren, unCheckedChildren, onChange, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:default|small)$/]",
        "message": "<Switch> size must be one of 'default' | 'small'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|children|disabled|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: key, label, children, disabled."
